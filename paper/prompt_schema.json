{
  "meta": {
    "name": "paper_summary_v1",
    "version": "1.0.0"
  },
  "roles": {
    "system": "당신은 논문의 핵심을 정리하는 수준 높은 전문 연구원입니다. 아래 출력 규칙과 스키마를 반드시 준수하십시오.",
    "user_template": [
      "다음 논문 내용을 요약해 콤마 구분값으로 출력하십시오.",
      "",
      "# 출력 규칙",
      "- 알 수 없으면 '알 수 없음', 해당 없으면 '해당 없음'.",
      "- 여러 하위항목은 줄바꿈 없이 * 접두로 나열(예: *항목1 *항목2).",
      "- 각 필드는 콤마(,)로 구분되므로, 본문 내 콤마는 '、'(U+3001)로 치환.",
      "- 지정된 최대 개수를 초과하지 말 것.",
      "",
      "# 입력 컨텍스트",
      "메타데이터:",
      "{metadata_block}",
      "",
      "배경/소개(요약):",
      "{intro_block}",
      "",
      "방법/데이터(요약):",
      "{methods_block}",
      "",
      "결과/결론(요약):",
      "{results_block}",
      "",
      "# 출력 스키마(필드 순서 고정)",
      "{fields_block}"
    ]
  },
  "fields": [
    {"key": "제목", "type": "string", "source": "metadata.title"},
    {"key": "저자", "type": "list",   "source": "metadata.authors", "joiner": ", "},
    {"key": "게재연도", "type": "string", "source": "metadata.year"},
    {"key": "학술지", "type": "string", "source": "metadata.journal"},
    {"key": "키워드", "type": "list", "max_items": 10, "source": "metadata.keywords"},
    {"key": "정량/정성", "type": "string"},
    {"key": "연구목적", "type": "list", "max_items": 3},
    {"key": "선행연구 한계점", "type": "list", "max_items": 5},
    {"key": "연구 대상지", "type": "list"},
    {"key": "데이터(종속변수)", "type": "list"},
    {"key": "데이터(독립변수)", "type": "list"},
    {"key": "분석방법", "type": "list"},
    {"key": "분석도구", "type": "list"},
    {"key": "주요 연구결과", "type": "list", "max_items": 5},
    {"key": "본연구의 한계점", "type": "list", "max_items": 3},
    {"key": "차후 연구제안", "type": "list", "max_items": 3}
  ],
  "output": {
    "format": "csv_line",
    "comma_escape_char": "、",
    "list_item_prefix": "*"
  },
  "context_policy": {
    "intro_block":  { "sections": ["introduction", "background", "related work"], "top_k": 6, "max_chars": 2500 },
    "methods_block":{ "sections": ["methods", "methodology", "data"],             "top_k": 8, "max_chars": 3000 },
    "results_block":{ "sections": ["results", "discussion", "conclusion"],        "top_k": 8, "max_chars": 3000 },
    "metadata_block": { "from": "metadata", "include": ["title","authors","year","journal","keywords"] }
  }
}